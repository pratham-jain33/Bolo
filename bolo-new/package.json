{
  "name": "bolo",
  "productName": "bolo",
  "version": "0.0.1",
  "description": "bolo - original voice interface prototype. No bolo code or assets included.",
  "main": "./src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "check": "node ./tools/check.js",
    "server": "node ./server/stub.js",
    "demo": "node ./server/stub.js & electron .",
    "dist": "electron-builder --win --x64 --dir"
  },
  "license": "MIT",
  "build": {
    "appId": "com.bolo.os",
    "productName": "bolo",
    "files": [
      "src/**/*",
      "server/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "dir"
      ]
    },
    "asar": true
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  }
}
